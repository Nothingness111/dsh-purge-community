{
  "name": "dsh-purge-community",
  "version": "1.1.83",
  "description": "DeepSeek Harness 破甲（社区维护版）：让所有模型都能破甲，不同模型可换不同提示词；默认提示词面向国模「小码酱」。Community-maintained fork of dsh-purge 1.1.82 with dsh 0.2.2-rc.2 compatibility and a verified asar-swap fallback.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "INSTALL.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-COMMERCIAL.md",
    "NOTICE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "postinstall": "node scripts/ensure-profile-bundle.mjs",
    "test": "node --test",
    "check:compat": "node scripts/check-compat.mjs"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "YuJunZhiXue (original author)",
    "email": "a2269198325@163.com"
  },
  "contributors": [
    {
      "name": "Nothingness111",
      "url": "https://github.com/Nothingness111",
      "note": "community maintenance: dsh 0.2.2-rc.2 compatibility, asar swap fallback"
    }
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nothingness111/dsh-purge-community.git"
  },
  "homepage": "https://github.com/Nothingness111/dsh-purge-community#readme",
  "bugs": {
    "url": "https://github.com/Nothingness111/dsh-purge-community/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://codeload.github.com/Nothingness111/dsh-purge-community/tar.gz/refs/heads/main",
      "zip": "https://codeload.github.com/Nothingness111/dsh-purge-community/zip/refs/heads/main",
      "git": "https://github.com/Nothingness111/dsh-purge-community.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.2-rc.2",
  "dshTargetRange": ">=0.2.1-rc.2 <0.2.3"
}
